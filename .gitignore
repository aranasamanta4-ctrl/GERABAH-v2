# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local SQLite (dev artifact, no longer used — Postgres/Supabase is the real datasource)
*.db
*.db-journal

# user-uploaded media (local disk storage — not suitable for git or serverless deploys)
/public/uploads

# AI tooling scaffolding (auto-installed skill docs / local assistant config — not app code)
/.claude
/.agents
/.windsurf
skills-lock.json

# Local scratch (screenshots, generated invoice previews)
.shots/
scripts/preview-invoice.pdf
scripts/preview-invoice.png

# Reference documents (large binaries — proposal, booklet, AppSheet export). Kept
# on disk for context but not committed. Descriptions live in docs/reference/README.md
/docs/reference/*
!/docs/reference/README.md
