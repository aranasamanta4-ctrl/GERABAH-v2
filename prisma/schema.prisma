// GERABAH v2 — Prisma schema
// PostgreSQL (Supabase).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Core ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("owner") // owner / staff
  createdAt    DateTime @default(now())

  businesses Business[]

  memberOfBusinessId String?
  memberOf           Business? @relation("BusinessStaff", fields: [memberOfBusinessId], references: [id], onDelete: Cascade)

  @@index([memberOfBusinessId])
}

model Business {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  location        String?
  categoryDefault String   @default("Gerabah / Keramik")
  createdAt       DateTime @default(now())

  staff                 User[]     @relation("BusinessStaff")
  customers             Customer[]
  productCategories     ProductCategory[]
  expenseCategories     ExpenseCategory[]
  incomeCategories      IncomeCategory[]
  salesChannels         SalesChannel[]
  paymentMethods        PaymentMethod[]
  products              Product[]
  sales                 Sale[]
  orders                Order[]
  financialTransactions FinancialTransaction[]
  payments              Payment[]
  workshops             Workshop[]
  activityLogs          ActivityLog[]
  assets                Asset[]
  fixedCostCategories   FixedCostCategory[]
  fixedCosts            FixedCost[]
  productOtherCostCategories ProductOtherCostCategory[]
  productChangeRequests ProductChangeRequest[]

  @@index([ownerId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  address    String?
  type       String   @default("New") // New/Returning/Reseller/Wholesale/Other
  notes      String?
  createdAt  DateTime @default(now())

  sales  Sale[]
  orders Order[]

  @@index([businessId])
}

// ── Lookup tables (per-business, editable) ──────────────

model ProductCategory {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  products   Product[]

  @@unique([businessId, name])
}

model ExpenseCategory {
  id           String                 @id @default(cuid())
  businessId   String
  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  transactions FinancialTransaction[] @relation("ExpenseCategoryTx")

  @@unique([businessId, name])
}

model IncomeCategory {
  id           String                 @id @default(cuid())
  businessId   String
  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  transactions FinancialTransaction[] @relation("IncomeCategoryTx")

  @@unique([businessId, name])
}

model SalesChannel {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  sales      Sale[]
  orders     Order[]

  @@unique([businessId, name])
}

model PaymentMethod {
  id           String                 @id @default(cuid())
  businessId   String
  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  sales        Sale[]
  transactions FinancialTransaction[]
  payments     Payment[]

  @@unique([businessId, name])
}

// ── Products ──────────────────────────────────────────

model Product {
  id           String           @id @default(cuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  photoUrl     String?
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  description  String?
  material     String?
  sellingPrice Float
  stock        Int              @default(0)
  minStock     Int              @default(0)
  status       String           @default("active") // active/inactive/out_of_stock
  createdAt    DateTime         @default(now())

  costComponents ProductCostComponent[]
  materials      ProductMaterial[]
  changeRequests ProductChangeRequest[]
  saleItems      SaleItem[]
  orderItems     OrderItem[]
  workshopGifts  WorkshopGift[]

  @@index([businessId])
}

model ProductCostComponent {
  id              String                    @id @default(cuid())
  productId       String
  product         Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  label           String  // Packaging Cost / Other Cost (Material Cost & Labor Cost lama dipindah ke ProductMaterial & FixedCost)
  amount          Float
  otherCategoryId String?
  otherCategory   ProductOtherCostCategory? @relation(fields: [otherCategoryId], references: [id])

  @@index([productId])
  @@index([otherCategoryId])
}

/** Rincian bahan baku per produk — pengganti materialCost yang dulu cuma satu angka. */
model ProductMaterial {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  quantity  Float   @default(1)
  unit      String  @default("pcs")
  unitCost  Float   @default(0)

  @@index([productId])
}

/** Kategori biaya "lain-lain" per produk — dipilih dari daftar atau tambah baru (bukan field bebas "lain-lain"). */
model ProductOtherCostCategory {
  id         String                 @id @default(cuid())
  businessId String
  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  components ProductCostComponent[]

  @@unique([businessId, name])
}

/** Pengajuan perubahan harga jual oleh staf — berlaku setelah disetujui owner. */
model ProductChangeRequest {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  field           String    @default("sellingPrice")
  oldValue        Float
  newValue        Float
  requestedById   String?
  requestedByName String
  status          String    @default("pending") // pending / approved / rejected
  reviewedById    String?
  reviewNote      String?
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?

  @@index([businessId, status])
  @@index([productId])
}

// ── Sales & Orders ────────────────────────────────────

model Sale {
  id                 String        @id @default(cuid())
  businessId         String
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  channelId          String?
  channel            SalesChannel? @relation(fields: [channelId], references: [id])
  date               DateTime      @default(now())
  subtotal           Float
  discount           Float         @default(0)
  total              Float
  amountPaid         Float         @default(0)
  outstandingBalance Float         @default(0)
  paymentStatus      String        @default("Unpaid") // Unpaid/Partially Paid/Paid/Cancelled
  paymentMethodId    String?
  paymentMethod      PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  orderId            String?        @unique
  order              Order?         @relation(fields: [orderId], references: [id])
  notes              String?

  items                 SaleItem[]
  financialTransactions FinancialTransaction[]
  payments              Payment[]

  @@index([businessId, date])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  lineTotal Float

  @@index([saleId])
}

model Order {
  id               String        @id @default(cuid())
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  channelId        String?
  channel          SalesChannel? @relation(fields: [channelId], references: [id])
  date             DateTime      @default(now())
  status           String        @default("New") // New/Confirmed/Processing/Ready/Completed/Cancelled
  paymentStatus    String        @default("Unpaid") // Unpaid/Partially Paid/Paid
  downPayment      Float         @default(0)
  remainingPayment Float         @default(0)
  total            Float
  dueDate          DateTime?
  notes            String?

  items    OrderItem[]
  sale     Sale?
  payments Payment[]

  @@index([businessId, status])
  @@index([businessId, dueDate])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  discount  Float   @default(0)

  @@index([orderId])
}

// ── Finance ───────────────────────────────────────────

model FinancialTransaction {
  id                String           @id @default(cuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type              String           // INCOME/EXPENSE
  incomeCategoryId  String?
  incomeCategory    IncomeCategory?  @relation("IncomeCategoryTx", fields: [incomeCategoryId], references: [id])
  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation("ExpenseCategoryTx", fields: [expenseCategoryId], references: [id])
  date              DateTime         @default(now())
  description       String?
  amount            Float
  paymentMethodId   String?
  paymentMethod     PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  reference         String?
  relatedSaleId     String?
  relatedSale       Sale?            @relation(fields: [relatedSaleId], references: [id])
  relatedWorkshopId String?
  relatedWorkshop   Workshop?        @relation(fields: [relatedWorkshopId], references: [id])
  notes             String?

  @@index([businessId, date, type])
}

// ── Aset & Biaya Tetap ────────────────────────────────
// Dihitung di awal (sebelum operasional jalan): daftar aset usaha + biaya yang jalan terus tiap
// bulan/tahun terlepas dari ramai-tidaknya penjualan (termasuk langganan software/alat).

model Asset {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  category      String    @default("Lainnya") // Alat Produksi / Kendaraan / Bangunan / Elektronik / Lainnya
  purchaseValue Float
  purchaseDate  DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  @@index([businessId])
}

model FixedCostCategory {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  fixedCosts FixedCost[]

  @@unique([businessId, name])
}

model FixedCost {
  id             String             @id @default(cuid())
  businessId     String
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  categoryId     String?
  category       FixedCostCategory? @relation(fields: [categoryId], references: [id])
  amount         Float
  period         String             @default("monthly") // monthly / yearly / one_time
  startDate      DateTime           @default(now())
  endDate        DateTime? // dipakai untuk langganan yang punya masa berlaku
  durationMonths Int? // opsional: lama langganan dalam bulan (buat hitung/tampilkan tanggal habis)
  active         Boolean            @default(true)
  note           String?
  createdAt      DateTime           @default(now())

  @@index([businessId])
  @@index([categoryId])
}

// ── Workshop ──────────────────────────────────────────

model Workshop {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  organizer       String // nama instansi / penyelenggara
  date            DateTime?
  participants    Int       @default(0)
  operationalCost Float     @default(0) // biaya bahan & operasional
  profitMode      String    @default("percent") // percent / nominal
  profitValue     Float     @default(0)
  // snapshot hasil hitung saat disimpan
  giftCost        Float     @default(0)
  totalCost       Float     @default(0)
  targetProfit    Float     @default(0)
  offerPrice      Float     @default(0)
  pricePerPerson  Float     @default(0)
  status          String    @default("draft") // draft / recorded
  recordedAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())

  gifts        WorkshopGift[]
  transactions FinancialTransaction[]

  @@index([businessId, createdAt])
}

model WorkshopGift {
  id         String   @id @default(cuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Float

  @@index([workshopId])
}

// ── Catatan aktivitas (log perubahan) ─────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  userName   String // snapshot nama saat kejadian
  role       String // owner / staff (snapshot)
  action     String // kode singkat, mis. "sale.create"
  summary    String // kalimat bahasa Indonesia
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

model Payment {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?         @relation(fields: [orderId], references: [id])
  saleId     String?
  sale       Sale?          @relation(fields: [saleId], references: [id])
  amount     Float
  methodId   String?
  method     PaymentMethod? @relation(fields: [methodId], references: [id])
  date       DateTime       @default(now())

  @@index([businessId])
}
